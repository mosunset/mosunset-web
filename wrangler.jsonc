{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mosunset-web",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "main": "@tanstack/react-start/server-entry",
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mosunset-web",
      // 本番用は `npx wrangler d1 create mosunset-web` で作成し、出力された ID に置き換える
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "drizzle"
    }
  ],
  "r2_buckets": [
    {
      // コレクションやブログの画像。本番用は `npx wrangler r2 bucket create mosunset-web-images` で作成する
      "binding": "IMAGES",
      "bucket_name": "mosunset-web-images"
    }
  ],
  // お問い合わせの通知メール。送り先は Email Routing で認証済みのアドレスに限られる
  "send_email": [{ "name": "EMAIL" }],
  "vars": {
    // 通知メールの送信元（mosunset.com で Email Routing を有効にしておく）
    "CONTACT_FROM": "noreply@mosunset.com",
    // Turnstile のサイトキー（公開してよい値）。今は Cloudflare のテスト用キー。本番のキーに置き換える
    "TURNSTILE_SITE_KEY": "1x00000000000000000000AA"
  }
}
