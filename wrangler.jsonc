{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mosunset-web",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "main": "@tanstack/react-start/server-entry",
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mosunset-web",
      // 本番用（2026-11-07 に `npx wrangler d1 create mosunset-web --location apac` で作成）。
      // ローカルの開発用データベースもこの ID ごとに分かれるので、変えたら migrate と取り込みをやり直す
      "database_id": "607e13ee-8d11-4b1b-a4c0-782b69cc26f0",
      "migrations_dir": "drizzle"
    }
  ],
  "r2_buckets": [
    {
      // コレクションやブログの画像。本番用は `npx wrangler r2 bucket create mosunset-web-images` で作成する
      "binding": "IMAGES",
      "bucket_name": "mosunset-web-images"
    }
  ],
  // お問い合わせの通知メール。送り先は Email Routing で認証済みのアドレスに限られる
  "send_email": [{ "name": "EMAIL" }],
  "vars": {
    // 通知メールの送信元（mosunset.com で Email Routing を有効にしておく）
    "CONTACT_FROM": "noreply@mosunset.com",
    // Turnstile のサイトキー（公開してよい値・mosunset.com 用）。
    // 開発中は .dev.vars でテスト用キーに上書きする。シークレットキーは `wrangler secret put TURNSTILE_SECRET_KEY`
    "TURNSTILE_SITE_KEY": "0x4AAAAAAF3C6_jGAZzC4eAG"
  }
}
