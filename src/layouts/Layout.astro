---
import "@/styles/global.css";
import { SEO } from "astro-seo";
const { pathname } = Astro.url;
import myImage from "@/assets/images/my.webp";
// import { ClientRouter } from "astro:transitions";

interface Props {
    title?: string;
    description?: string;
    keywords?: string[];
}

const { title: pTitle } = Astro.props as Props;
const title = pTitle ? `${pTitle} | mosunset` : "mosunset";
const { description: pDescription } = Astro.props as Props;
const description = pDescription
    ? `${pDescription} - mosunsetのウェブサイト`
    : "mosunsetのウェブサイト - ブログ、楽器、プレイグラウンドなどのコンテンツを提供しています";
const image = myImage;
const { keywords: pKeywords } = Astro.props as Props;
const defaultKeywords: string[] = [
    "mosunset",
    "ブログ",
    "楽器",
    "プレイグラウンド",
    "書籍",
    "プログラミング",
    "技術",
];
const keywords: string[] = pKeywords
    ? [...pKeywords, ...defaultKeywords]
    : defaultKeywords;

const navLinkClass = (href: string) =>
    pathname.startsWith(href)
        ? "font-medium text-blue-500 focus:outline-hidden"
        : "font-medium text-gray-700 hover:text-gray-500 hover:underline hover:underline-offset-2 focus:outline-hidden focus:text-gray-500 focus:underline focus:underline-offset-2";
---

<!doctype html>
<html lang="ja">
    <head>
        <meta name="viewport" content="width=device-width" />
        <link rel="icon" type="image/x-icon" href="/favicon.ico" />
        <meta name="generator" content={Astro.generator} />
        <meta name="keywords" content={keywords.join(",")} />
        <meta name="author" content="mosunset" />
        <meta name="publisher" content="mosunset" />
        <SEO
            title={title}
            description={description}
            canonical={`https://mosunset.com${pathname}`}
            languageAlternates={[
                {
                    href: "https://mosunset.com",
                    hrefLang: "ja",
                },
            ]}
            charset="UTF-8"
            openGraph={{
                basic: {
                    type: "website",
                    url: "https://mosunset.com",
                    title: title,
                    image: image.src,
                },
            }}
            twitter={{
                card: "summary_large_image",
                site: "@TMoSunset0",
                title: title,
                description: description,
                image: image.src,
            }}
        />
        <!-- <ClientRouter /> -->
    </head>
    <body class="flex flex-col min-h-dvh min-w-80 overflow-x-hidden">
        <header
            class="container mx-auto px-4 sm:px-6 lg:px-8 pb-8 flex flex-wrap sm:justify-start sm:flex-nowrap w-full bg-white text-sm py-3"
        >
            <nav class="w-full sm:flex sm:items-center sm:justify-between">
                <a
                    class="flex-none font-semibold text-xl text-black focus:outline-hidden focus:opacity-80"
                    href="/"
                    aria-label="mosunset">mosunset</a
                >
                <div
                    class="flex flex-row items-center gap-5 mt-5 sm:justify-end sm:mt-0 sm:ps-5"
                >
                    <a class={navLinkClass("/blog")} href="/blog">Blog</a>
                    <a class={navLinkClass("/playground")} href="/playground"
                        >Playground</a
                    >
                    <a class={navLinkClass("/book")} href="/book">Book</a>
                    <a class={navLinkClass("/instruments")} href="/instruments"
                        >楽器</a
                    >
                    <a
                        class={navLinkClass("/qualifications")}
                        href="/qualifications">資格・試験</a
                    >
                </div>
            </nav>
        </header>
        <div class="container mx-auto px-4 sm:px-6 lg:px-8 flex-grow">
            <slot />
        </div>
        <footer class="w-full container mx-auto px-4 sm:px-6 lg:px-8 py-4">
            <div class="py-6 border-t border-gray-200">
                <div class="flex flex-wrap justify-between items-center gap-2">
                    <div>
                        <p class="text-xs text-gray-600">
                            © 2025 <a
                                href="/keystatic"
                                target="_blank"
                                class="text-gray-600">mosunset.</a
                            >
                        </p>
                    </div>
                    <ul class="flex flex-wrap items-center">
                        <li
                            class="inline-block relative pe-4 text-xs last:pe-0 last-of-type:before:hidden before:absolute before:top-1/2 before:end-1.5 before:-translate-y-1/2 before:size-[3px] before:rounded-full before:bg-gray-400"
                        >
                            <a
                                class="text-xs text-gray-500 underline hover:text-gray-800 hover:decoration-2 focus:outline-hidden focus:decoration-2"
                                href="https://x.com/TMoSunset0"
                            >
                                X (Twitter)
                            </a>
                        </li>
                        <li class="inline-block pe-4 text-xs">
                            <a
                                class="text-xs text-gray-500 underline hover:text-gray-800 hover:decoration-2 focus:outline-hidden focus:decoration-2"
                                href="https://github.com/mosunset"
                            >
                                Github
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
        </footer>
    </body>
</html>

<style>
    html,
    body {
        margin: 0;
        width: 100%;
        height: 100%;
    }
</style>
