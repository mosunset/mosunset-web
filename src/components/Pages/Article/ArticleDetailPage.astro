---
import { Image } from "astro:assets";

interface Props {
    entry: any;
    sectionName: string;
    sectionSlug: string;
    transitionName: string;
    titleField?: string;
    thumbnailField?: string;
    showThumbnail?: boolean;
}

const {
    entry,
    sectionName,
    sectionSlug,
    transitionName,
    titleField = "title",
    thumbnailField = "thumbnail",
    showThumbnail = true,
} = Astro.props;

const { Content } = await entry.render();
const title = entry.data[titleField];
const thumbnail = entry.data[thumbnailField];
---

<div class="w-full max-w-2xl mx-auto mb-8">
    <a
        href={`/${sectionSlug}`}
        class="flex items-center gap-2"
        title={`${sectionName}一覧へ戻る`}
    >
        <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="currentColor"
            class="w-6 h-6"
        >
            <path
                fill-rule="evenodd"
                d="M11.03 3.97a.75.75 0 0 1 0 1.06l-6.22 6.22H21a.75.75 0 0 1 0 1.5H4.81l6.22 6.22a.75.75 0 1 1-1.06 1.06l-7.5-7.5a.75.75 0 0 1 0-1.06l7.5-7.5a.75.75 0 0 1 1.06 0Z"
                clip-rule="evenodd"></path>
        </svg>
        <span class="text-sm"
            ><span transition:persist-props transition:name={transitionName}
                >{sectionName}</span
            >一覧へ戻る</span
        >
    </a>
</div>
<div class="w-full max-w-2xl mx-auto">
    {
        showThumbnail && thumbnail && (
            <Image
                src={thumbnail}
                class="object-cover w-full max-w-lg mx-auto mb-8 rounded-lg shadow-lg"
                format="webp"
                alt={title}
                title={title}
                loading="lazy"
                transition:persist-props
                transition:name={entry.slug + "-thumbnail"}
            />
        )
    }

    <div class="mb-8">
        <h1
            class="text-3xl font-bold mb-4 text-gray-900"
            transition:persist-props
            transition:name={entry.slug + "-title"}
        >
            {title}
        </h1>

        <!-- スロット：メタ情報 -->
        <slot name="metadata" />

        <!-- スロット：カテゴリーとタグ -->
        <div class="flex flex-wrap items-center gap-4 text-sm text-gray-500">
            <slot name="category-tags" />
        </div>
    </div>

    <!-- スロット：追加コンテンツ（例：楽器の写真ギャラリー） -->
    <slot name="additional-content" />

    <hr class="mb-4 text-gray-200" />

    <article class="prose mx-auto">
        <Content />
    </article>
</div>
