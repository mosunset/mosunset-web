---
import InitMasonry from "@/components/initMasonry/index.astro";

interface Props {
    tag: string;
    tagPosts: any[];
    otherTags: string[];
    postsByTag: Record<string, any[]>;
    sectionName: string;
    sectionSlug: string;
    accentColor?: string;
    CardComponent: any;
    highlightTag?: boolean;
    countLabel?: string;
}

const {
    tag,
    tagPosts,
    otherTags,
    postsByTag,
    sectionName,
    sectionSlug,
    accentColor = "green",
    CardComponent,
    highlightTag = false,
    countLabel = "件の記事",
} = Astro.props;
---

<style>
    /* Masonryコンテナのスタイル */
    .masonry-container {
        width: 100%;
    }
</style>

<h1 class="text-3xl font-bold text-gray-900 mb-8">
    タグ：#{tag}
</h1>

<!-- 指定されたタグのカード表示 -->
<div class="mb-8">
    {
        tagPosts.length === 0 ? (
            <div class="text-center text-gray-500">
                <p>このタグには{sectionName}がありません</p>
            </div>
        ) : (
            <div>
                <div id="masonry-container" class="masonry-container">
                    {tagPosts.map((post) => (
                        <CardComponent
                            {...{
                                [sectionName === "ブログ"
                                    ? "blog"
                                    : sectionName === "蔵書"
                                      ? "book"
                                      : sectionName === "資格"
                                        ? "qualification"
                                        : sectionName === "楽器"
                                          ? "instrument"
                                          : "playground"]: post,
                            }}
                            highlightTag={highlightTag ? tag : undefined}
                        />
                    ))}
                </div>
                <InitMasonry id="masonry-container" item=".masonry-item" />
            </div>
        )
    }
</div>

<!-- 他のタグへのリンク -->
{
    otherTags.length > 0 && (
        <div class="mt-12">
            <h2 class="text-xl font-bold text-gray-800 mb-4 pb-2 border-b border-gray-200">
                他のタグ
            </h2>
            <div class="flex flex-wrap gap-2">
                {otherTags.map((t) => (
                    <a
                        title={t}
                        href={`/${sectionSlug}/tags/${t}`}
                        class={`inline-flex items-center gap-2 px-3 py-2 bg-white hover:bg-${accentColor}-50 rounded border border-gray-300 shadow-sm hover:shadow transition-shadow whitespace-nowrap`}
                    >
                        <span class="font-semibold text-gray-900 text-base">
                            #{t}
                        </span>
                        <span class="text-xs text-gray-600">
                            {postsByTag[t].length}件
                        </span>
                    </a>
                ))}
                <a
                    title="タグ一覧を見る"
                    href={`/${sectionSlug}/tags/`}
                    class={`inline-flex items-center gap-2 px-3 py-2 bg-${accentColor}-100 hover:bg-${accentColor}-200 rounded border border-${accentColor}-300 shadow-sm hover:shadow transition-shadow font-semibold text-${accentColor}-900 whitespace-nowrap text-base`}
                >
                    タグ一覧を見る →
                </a>
            </div>
        </div>
    )
}
