---
import { Image } from "astro:assets";

export interface Props {
    href: string;
    title: string;
    thumbnail?: any;
    masonryClass?: string;
    children?: any;
}

const { href, title, thumbnail, masonryClass = "", children } = Astro.props;
---

<article
    class={`masonry-item bg-white border border-gray-200 rounded-lg shadow-sm hover:shadow-md transition-shadow overflow-hidden mb-6 opacity-0 transition-opacity duration-300 w-full md:w-[calc(50%-12px)] lg:w-[calc(33.333%-16px)] xl:w-[calc(25%-18px)] ${masonryClass}`}
>
    <div class="relative">
        {
            thumbnail && (
                <Image
                    src={thumbnail.src}
                    format="webp"
                    alt={title}
                    title={title}
                    loading="lazy"
                    class="w-full object-cover"
                />
            )
        }
        <div class="p-6">
            <slot />
        </div>
        <a href={href} class="absolute inset-0" title={title}></a>
    </div>
</article>
