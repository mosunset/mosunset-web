---
import { Image } from "astro:assets";

export interface Props {
    href: string;
    title: string;
    thumbnail?: any;
    masonryClass?: string;
    children?: any;
}

const { href, title, thumbnail, masonryClass = "", children } = Astro.props;
---

<article
    class={`masonry-item bg-white border border-gray-200 rounded-lg shadow-sm hover:shadow-md transition-shadow overflow-hidden ${masonryClass}`}
>
    <div class="relative">
        {
            thumbnail && (
                <Image
                    src={thumbnail.src}
                    format="webp"
                    alt={title}
                    title={title}
                    loading="lazy"
                    class="w-full object-cover"
                />
            )
        }
        <div class="p-6">
            <slot />
        </div>
        <a href={href} class="absolute inset-0" title={title}></a>
    </div>
</article>

<style>
    /* Masonryアイテムのスタイル */
    .masonry-item {
        width: 100%;
        margin-bottom: 1.5rem;
        opacity: 0;
        transition: opacity 0.3s ease-in-out;
    }

    .masonry-item.loaded {
        opacity: 1;
    }

    /* 画像のアスペクト比を保持 */
    .masonry-item img {
        width: 100%;
        height: auto;
        display: block;
    }

    /* レスポンシブ対応 - Masonry.jsが自動でカラム幅を計算するため、固定幅を設定 */
    @media (min-width: 768px) {
        .masonry-item {
            width: calc(50% - 12px);
        }
    }

    @media (min-width: 1024px) {
        .masonry-item {
            width: calc(33.333% - 16px);
        }
    }

    @media (min-width: 1280px) {
        .masonry-item {
            width: calc(25% - 18px);
        }
    }
</style>
