---
import BaseCard from "./BaseCard.astro";
import CardTitle from "./CardTitle.astro";
import CardMetaInfo from "./CardMetaInfo.astro";
import CardDate from "./CardDate.astro";
import CardTags from "./CardTags.astro";

export interface Props {
    instrument: any; // instruments collectionの型
    masonryClass?: string; // Masonry用のクラス名（オプション）
}

const { instrument, masonryClass = "" } = Astro.props;
const post = instrument;
---

<BaseCard
    href={`/instruments/${post.slug}/`}
    title={post.data.name}
    thumbnail={post.data.thumbnail
        ? {
              src: post.data.thumbnail,
          }
        : undefined}
    masonryClass={masonryClass}
>
    <CardTitle title={post.data.name} />

    <CardMetaInfo label="ブランド" value={post.data.brand} />

    <CardMetaInfo label="楽器名" value={post.data.instrumentName} />

    <CardTags
        category={post.data.type}
        tags={post.data.tags}
        basePath="/instruments"
    />

    {
        post.data.purchaseDate && (
            <div class="flex flex-col gap-1 mt-auto">
                <CardDate
                    date={new Date(post.data.purchaseDate)}
                    label="入手日"
                />
            </div>
        )
    }
</BaseCard>
