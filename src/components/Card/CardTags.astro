---
export interface Props {
    category?: string;
    tags?: string[];
    highlightTag?: string;
    basePath?: string; // ベースパス（例: '/blog', '/book', '/instruments'など）
}

const {
    category,
    tags,
    highlightTag,
    basePath = "/qualifications",
} = Astro.props;
---

<div class="flex flex-wrap gap-2 mb-3">
    {
        category && (
            <a
                href={`${basePath}/categorys/${category}`}
                class="px-2 py-1 bg-blue-100 text-blue-800 text-xs rounded-full z-50"
                title={category}
            >
                {category}
            </a>
        )
    }

    {
        tags &&
            tags.length > 0 &&
            tags.map((tag: string) => (
                <a
                    href={`${basePath}/tags/${tag}`}
                    title={tag}
                    class={`px-2 py-1 text-xs rounded z-50 break-words max-w-full ${
                        highlightTag && tag === highlightTag
                            ? "bg-green-100 text-green-700"
                            : "bg-gray-100 text-gray-700"
                    }`}
                >
                    #{tag}
                </a>
            ))
    }
</div>
