---
// initMasonry/index.astro

// Astro.propsから設定を受け取り、デフォルト値を設定
const {
    id = "masonry-container",
    item = ".masonry-item",
    gutter = 24,
    transitionDuration = "0.2s",
} = Astro.props;
---

<script define:vars={{ id, item, gutter, transitionDuration }}>
    // 各インスタンスでは変数を使ってグローバル関数を呼び出すだけ
    const executeInit = () => {
        if (window.__masonryInit) {
            window.__masonryInit(id, item, gutter, transitionDuration);
        }
    };

    // ページ読み込み時に実行
    if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", executeInit);
    } else {
        executeInit();
    }
</script>
