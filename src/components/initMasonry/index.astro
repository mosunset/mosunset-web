---
// initMasonry/index.astro
---
<script src="https://unpkg.com/masonry-layout@4/dist/masonry.pkgd.min.js"></script>
<script src="https://unpkg.com/imagesloaded@5/imagesloaded.pkgd.min.js"></script>
<script>

    // Masonryのインスタンスを保持するためのグローバル変数を定義
    let masonryInstance: { destroy: () => void; layout: () => void };

    const initMasonry = () => {
        const container = document.getElementById("masonry-container");
        if (!container) return; // コンテナがなければ処理を中断

        // 既存のインスタンスがあれば破棄する (AstroのView Transitionsで必須)
        if (masonryInstance) {
            masonryInstance.destroy();
        }

        // 先にMasonryのインスタンスを初期化
        masonryInstance = new Masonry(container, {
            itemSelector: ".masonry-item",
            columnWidth: ".masonry-item",
            percentPosition: true,
            horizontalOrder: true,
            transitionDuration: "0.2s",
            gutter: 24,
        });

        // imagesLoadedを使用して、コンテナ内の画像の読み込みを監視
        // 画像が1つ読み込まれるたびに 'progress' イベントが発生
        imagesLoaded(container).on("progress", () => {
            // Masonryのレイアウトを再計算して適用
            masonryInstance.layout();
        });

        // Masonryアイテムを可視化（CSSでのアニメーション用）
        const items = container.querySelectorAll(".masonry-item");
        items.forEach((item) => item.classList.add("loaded"));
    };

    // DOMが完全に読み込まれた初回ロード時に初期化
    document.addEventListener("DOMContentLoaded", initMasonry);

    // AstroのView Transitionsでページが切り替わった直後に再初期化
    document.addEventListener("astro:after-swap", initMasonry);

    // Astroのページが読み込まれた直後に初期化
    document.addEventListener("astro:page-load", initMasonry);
</script>
