---
import Layout from "@/layouts/Layout.astro";
import BlogCard from "@/components/Card/BlogCard.astro";
import CategorysListPage from "@/components/Pages/Categorys/CategorysListPage.astro";
import {
    getPublicPosts,
    getPostsByCategorySorted,
    SECTION_CONFIGS,
} from "@/components/Pages/utils";

const config = SECTION_CONFIGS.blog;

// コレクションから公開記事を取得
const publicPosts = await getPublicPosts(config.collectionName);

// カテゴリーごとにグループ化してソート
const postsByCategory = getPostsByCategorySorted(publicPosts, config.sortField);
---

<Layout title="カテゴリー - ブログ一覧">
    <CategorysListPage
        postsByCategory={postsByCategory}
        sectionName={config.sectionName}
        borderColor="border-blue-200"
        CardComponent={BlogCard}
    />
</Layout>
