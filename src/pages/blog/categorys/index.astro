---
import Layout from "@/layouts/Layout.astro";
import { AllGroupsView } from "@/components/Pages/GroupedItemList";
import {
    getPublicPosts,
    getPostsByCategorySorted,
    SECTION_CONFIGS,
} from "@/components/Pages/utils";

const config = SECTION_CONFIGS.blog;
const publicPosts = await getPublicPosts(config.collectionName);
const postsByCategory = getPostsByCategorySorted(publicPosts, config.sortField);
---

<Layout title="カテゴリー - ブログ一覧">
    <AllGroupsView
        client:load
        heading="カテゴリー：ブログ"
        groupedPosts={postsByCategory}
        kind="blog"
        groupType="categorys"
        sectionSlug="blog"
    />
</Layout>
