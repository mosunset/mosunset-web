---
import Layout from "@/layouts/Layout.astro";
import { getCollection } from "astro:content";
import { Image } from "astro:assets"; // 画像の表示には <Image> が必要

// 'blog' コレクションから全記事を取得
const allPosts = await getCollection("blog");

// 下書きを除外
const publishedPosts = allPosts.filter((post) => !post.data.draft);

// 公開範囲が公開以外のものを除外
const publicPosts = publishedPosts.filter(
    (post) => post.data.visibility === "public"
);

// 日付の新しい順に並び替え
// 更新日が存在する場合は更新日を優先
// 更新日が存在しない場合は公開日を優先
publicPosts.sort(
    (a, b) =>
        new Date(b.data.updatedDate || b.data.publishedDate).getTime() -
        new Date(a.data.updatedDate || a.data.publishedDate).getTime()
);
---

<Layout title="ブログ一覧">
    <h1 class="text-3xl font-bold text-gray-900 mb-8">ブログ</h1>
    <div
        class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6"
    >
        {
            publicPosts.length === 0 ? (
                <div class="col-span-full text-center text-gray-500">
                    <p>記事がありません</p>
                </div>
            ) : (
                publicPosts.map((post) => (
                    <div class="bg-white border border-gray-200 rounded-lg shadow-sm hover:shadow-md transition-shadow overflow-hidden">
                        <a href={`/blog/${post.slug}/`} class="block">
                            {/* 詳細ページへのリンク */}
                            <Image
                                src={post.data.thumbnail}
                                format="webp"
                                alt=""
                                class="w-full object-cover"
                            />
                            <div class="p-6">
                                <h2 class="text-xl font-semibold text-gray-900 mb-2">
                                    {post.data.title}
                                </h2>
                                <p class="text-gray-600 mb-3">
                                    {post.data.description}
                                </p>
                                <div class="flex flex-wrap gap-2 mb-3">
                                    <span class="px-2 py-1 bg-blue-100 text-blue-800 text-xs rounded-full">
                                        {post.data.category}
                                    </span>
                                    {post.data.tags && post.data.tags.map((tag) => (
                                        <span class="px-2 py-1 bg-gray-100 text-gray-700 text-xs rounded-full">
                                            {tag}
                                        </span>
                                    ))}
                                </div>
                                <div class="flex flex-col gap-1">
                                    <time class="text-sm text-gray-500">
                                        公開日: {new Date(
                                            post.data.publishedDate
                                        ).toLocaleDateString("ja-JP")}
                                    </time>
                                    {post.data.updatedDate && (
                                        <time class="text-sm text-gray-500">
                                            更新日: {new Date(
                                                post.data.updatedDate
                                            ).toLocaleDateString("ja-JP")}
                                        </time>
                                    )}
                                </div>
                            </div>
                        </a>
                    </div>
                ))
            )
        }
    </div>
    <pre>
{JSON.stringify(allPosts, null, 2)}
    </pre>
</Layout>
