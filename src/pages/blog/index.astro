---
import Layout from "@/layouts/Layout.astro";
import { getCollection } from "astro:content";
import InitMasonry from "@/components/initMasonry/index.astro";
import BlogCard from "@/components/Card/BlogCard.astro";

// 'blog' コレクションから全記事を取得
const allPosts = await getCollection("blog");

// 下書きを除外
const publishedPosts = allPosts.filter((post) => !post.data.draft);

// 公開範囲が公開以外のものを除外
const publicPosts = publishedPosts.filter(
    (post) => post.data.visibility === "public"
);

// 日付の新しい順に並び替え
// 更新日が存在する場合は更新日を優先
// 更新日が存在しない場合は公開日を優先
publicPosts.sort(
    (a, b) =>
        new Date(b.data.updatedDate || b.data.publishedDate).getTime() -
        new Date(a.data.updatedDate || a.data.publishedDate).getTime()
);
---

<Layout title="ブログ一覧">
    <style>
        /* Masonryコンテナのスタイル */
        .masonry-container {
            width: 100%;
        }
    </style>
    <h1 class="text-3xl font-bold text-gray-900 mb-8">ブログ</h1>
    <div id="masonry-container" class="masonry-container">
        {
            publicPosts.length === 0 ? (
                <div class="col-span-full text-center text-gray-500">
                    <p>記事がありません</p>
                </div>
            ) : (
                publicPosts.map((post) => <BlogCard blog={post} />)
            )
        }
    </div>
    <InitMasonry />
</Layout>
