---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import Layout from "@/layouts/Layout.astro";

// 1. Astroにどのページを生成すべきか教える
export async function getStaticPaths() {
    const allPosts = await getCollection("blog");
    // 下書きを除外
    const publishedPosts = allPosts.filter((post) => !post.data.draft);

    // 公開範囲が非公開のものを除外
    const publicPosts = publishedPosts.filter(
        (post) => post.data.visibility !== "private"
    );
    return publicPosts.map((post) => ({
        params: { slug: post.slug },
        props: { entry: post }, // ページコンポーネントに記事データ(entry)を渡す
    }));
}

// 2. propsで記事データを受け取る
const { entry } = Astro.props;
const { Content } = await entry.render(); // Markdown本文をHTMLコンポーネントに変換
---

<Layout title={entry.data.title}>
    <Image
        src={entry.data.thumbnail}
        class="object-cover aspect-[4/3]"
        format="webp"
        alt=""
    />

    <h1>{entry.data.title}</h1>
    <p>{entry.data.description}</p>

    <hr />

    <div class="prose">
        <Content />
    </div>
</Layout>
