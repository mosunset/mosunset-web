---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import ArticleDetailPage from "@/components/Pages/Article/ArticleDetailPage.astro";
import { SECTION_CONFIGS } from "@/components/Pages/utils";

const config = SECTION_CONFIGS.blog;

// 1. Astroにどのページを生成すべきか教える
export async function getStaticPaths() {
    const allPosts = await getCollection("blog");
    const publishedPosts = allPosts.filter((post) => !post.data.draft);
    const publicPosts = publishedPosts.filter(
        (post) => post.data.visibility !== "private"
    );

    return publicPosts.map((post) => ({
        params: { slug: post.slug },
        props: { entry: post },
    }));
}

const { entry } = Astro.props;
---

<Layout title={entry.data.title}>
    <ArticleDetailPage
        entry={entry}
        sectionName={config.sectionName}
        sectionSlug={config.sectionSlug}
        transitionName={config.transitionName}
    >
        <Fragment slot="metadata">
            {
                entry.data.description && (
                    <p
                        class="text-lg text-gray-600 mb-4"
                        transition:persist-props
                        transition:name={entry.slug + "-description"}
                    >
                        {entry.data.description}
                    </p>
                )
            }
            <div
                class="flex flex-wrap items-center gap-4 text-sm text-gray-500 mb-4"
            >
                <time
                    datetime={entry.data.publishedDate.toISOString()}
                    transition:persist-props
                    transition:name={entry.slug + "-publishedDate"}
                >
                    公開:{" "}
                    {
                        entry.data.publishedDate.toLocaleDateString("ja-JP", {
                            year: "numeric",
                            month: "long",
                            day: "numeric",
                        })
                    }
                </time>
                {
                    entry.data.updatedDate && (
                        <time
                            datetime={entry.data.updatedDate.toISOString()}
                            transition:persist-props
                            transition:name={entry.slug + "-updatedDate"}
                        >
                            更新:{" "}
                            {entry.data.updatedDate.toLocaleDateString(
                                "ja-JP",
                                {
                                    year: "numeric",
                                    month: "long",
                                    day: "numeric",
                                }
                            )}
                        </time>
                    )
                }

                {
                    entry.data.visibility === "unlisted" && (
                        <span class="px-3 py-1 bg-yellow-100 text-yellow-700 rounded-full text-xs font-medium">
                            限定公開
                        </span>
                    )
                }
            </div>
        </Fragment>

        <Fragment slot="category-tags">
            <a
                href={`/blog/categorys/${entry.data.category}`}
                title={entry.data.category}
                class="px-3 py-1 bg-blue-100 text-blue-800 rounded-full text-xs font-medium"
                transition:persist-props
                transition:name={entry.slug + "-category"}
            >
                {entry.data.category}
            </a>

            {
                entry.data.tags && entry.data.tags.length > 0 && (
                    <div
                        class="flex gap-2"
                        transition:persist-props
                        transition:name={entry.slug + "-tag"}
                    >
                        {entry.data.tags.map((tag) => (
                            <a
                                href={`/blog/tags/${tag}`}
                                title={tag}
                                class="px-2 py-1 bg-gray-100 text-gray-700 rounded text-xs"
                            >
                                #{tag}
                            </a>
                        ))}
                    </div>
                )
            }
        </Fragment>
    </ArticleDetailPage>
</Layout>
