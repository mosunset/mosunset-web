---
import Layout from "@/layouts/Layout.astro";
import { getCollection } from "astro:content";
import ItemList from "@/components/ViewToggle/ItemList";
import type { ItemData } from "@/components/ViewToggle/ItemList";

const allPosts = await getCollection("qualifications");

const posts = allPosts
    .filter((p) => !p.data.draft && p.data.visibility === "public")
    .sort(
        (a, b) =>
            new Date(b.data.acquiredDate ?? "2000-01-01").getTime() -
            new Date(a.data.acquiredDate ?? "2000-01-01").getTime(),
    );

const items: ItemData[] = posts.map((p) => ({
    kind: "qualification",
    href: `/qualifications/${p.slug}/`,
    title: p.data.name,
    thumbnailSrc: p.data.thumbnail?.src,
    organization: p.data.organization,
    category: p.data.category,
    tags: p.data.tags,
    status: p.data.status,
    acquiredDate: p.data.acquiredDate?.toString(),
    score: p.data.score,
}));
---

<Layout title="資格一覧">
    <h1 class="text-3xl font-bold text-gray-900 mb-6">資格・試験</h1>
    {
        items.length === 0 ? (
            <p class="text-center text-gray-500">資格がありません</p>
        ) : (
            <ItemList client:load items={items} />
        )
    }
</Layout>
