---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import ArticleDetailPage from "@/components/Pages/Article/ArticleDetailPage.astro";
import { SECTION_CONFIGS } from "@/components/Pages/utils";

const config = SECTION_CONFIGS.qualifications;

// 1. Astroにどのページを生成すべきか教える
export async function getStaticPaths() {
    const allPosts = await getCollection("qualifications");
    const publishedPosts = allPosts.filter((post) => !post.data.draft);
    const publicPosts = publishedPosts.filter(
        (post) => post.data.visibility !== "private"
    );

    return publicPosts.map((post) => ({
        params: { slug: post.slug },
        props: { entry: post },
    }));
}

const { entry } = Astro.props;
---

<Layout title={entry.data.name}>
    <ArticleDetailPage
        entry={entry}
        sectionName={config.sectionName}
        sectionSlug={config.sectionSlug}
        transitionName={config.transitionName}
        titleField="name"
        showThumbnail={!!entry.data.thumbnail}
    >
        <Fragment slot="metadata">
            <h1
                class="text-3xl font-bold mb-4 text-gray-900"
                transition:persist-props
                transition:name={entry.slug + "-title"}
            >
                {entry.data.name}{" "}
                <span
                    class="px-2 py-1 bg-green-100 text-green-800 text-xs rounded-full"
                >
                    {entry.data.status}
                </span>
            </h1>
            <p
                class="text-gray-600 mb-2 text-sm"
                transition:persist-props
                transition:name={entry.slug + "-organization"}
            >
                実施団体: {entry.data.organization}
            </p>
            {
                entry.data.score && (
                    <p class="text-gray-600 mb-2 text-sm">
                        スコア: {entry.data.score}
                    </p>
                )
            }
            {
                entry.data.certificateNumber && (
                    <p class="text-gray-600 mb-2 text-sm">
                        証明書番号: {entry.data.certificateNumber}
                    </p>
                )
            }
            {
                entry.data.acquiredDate && (
                    <time
                        class="block text-gray-600 mb-2 text-sm"
                        datetime={entry.data.acquiredDate.toISOString()}
                        transition:persist-props
                        transition:name={entry.slug + "-acquiredDate"}
                    >
                        取得日:{" "}
                        {new Date(entry.data.acquiredDate).toLocaleDateString(
                            "ja-JP",
                            {
                                year: "numeric",
                                month: "long",
                                day: "numeric",
                            }
                        )}
                    </time>
                )
            }
            {
                entry.data.validityPeriod && (
                    <time
                        class="block text-gray-600 mb-2 text-sm"
                        datetime={entry.data.validityPeriod.toISOString()}
                        transition:persist-props
                        transition:name={entry.slug + "-validityPeriod"}
                    >
                        有効期限:{" "}
                        {new Date(entry.data.validityPeriod).toLocaleDateString(
                            "ja-JP",
                            {
                                year: "numeric",
                                month: "long",
                                day: "numeric",
                            }
                        )}
                    </time>
                )
            }
        </Fragment>

        <Fragment slot="category-tags">
            {
                entry.data.visibility === "unlisted" && (
                    <span class="px-3 py-1 bg-yellow-100 text-yellow-700 rounded-full text-xs font-medium">
                        限定公開
                    </span>
                )
            }
            <a
                href={`/qualifications/categorys/${entry.data.category}`}
                title={entry.data.category}
                class="px-3 py-1 bg-blue-100 text-blue-800 rounded-full text-xs font-medium"
                transition:persist-props
                transition:name={entry.slug + "-category"}
            >
                {entry.data.category}
            </a>

            {
                entry.data.tags && entry.data.tags.length > 0 && (
                    <div
                        class="flex gap-2"
                        transition:persist-props
                        transition:name={entry.slug + "-tag"}
                    >
                        {entry.data.tags.map((tag) => (
                            <a
                                href={`/qualifications/tags/${tag}`}
                                title={tag}
                                class="px-2 py-1 bg-gray-100 text-gray-700 rounded text-xs"
                            >
                                #{tag}
                            </a>
                        ))}
                    </div>
                )
            }
        </Fragment>
    </ArticleDetailPage>
</Layout>
