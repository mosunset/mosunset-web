---
import Layout from "@/layouts/Layout.astro";
import QualificationCard from "@/components/Card/QualificationCard.astro";
import TagsListPage from "@/components/Pages/Tags/TagsListPage.astro";
import {
    getPublicPosts,
    getPostsByTagSorted,
    SECTION_CONFIGS,
} from "@/components/Pages/utils";

const config = SECTION_CONFIGS.qualifications;

// コレクションから公開記事を取得
const publicPosts = await getPublicPosts(config.collectionName);

// タグごとにグループ化してソート
const postsByTag = getPostsByTagSorted(publicPosts, config.sortField);
---

<Layout title="タグ - 資格一覧">
    <TagsListPage
        postsByTag={postsByTag}
        sectionName={config.sectionName}
        borderColor="border-green-200"
        CardComponent={QualificationCard}
        highlightTag={true}
    />
</Layout>
