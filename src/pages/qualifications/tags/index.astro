---
import Layout from "@/layouts/Layout.astro";
import { AllGroupsView } from "@/components/Pages/GroupedItemList";
import {
    getPublicPosts,
    getPostsByTagSorted,
    SECTION_CONFIGS,
} from "@/components/Pages/utils";

const config = SECTION_CONFIGS.qualifications;
const publicPosts = await getPublicPosts(config.collectionName);
const postsByTag = getPostsByTagSorted(publicPosts, config.sortField);
---

<Layout title="タグ - 資格一覧">
    <AllGroupsView
        client:load
        heading="タグ：資格・試験"
        groupedPosts={postsByTag}
        kind="qualification"
        groupType="tags"
        sectionSlug="qualifications"
    />
</Layout>
