---
import Layout from "@/layouts/Layout.astro";
import { SingleGroupView } from "@/components/Pages/GroupedItemList";
import {
    getPublicPosts,
    getPostsByCategorySorted,
    generateCategoryPaths,
    sortPostsByDate,
    SECTION_CONFIGS,
} from "@/components/Pages/utils";

export async function getStaticPaths() {
    const posts = await getPublicPosts(
        SECTION_CONFIGS.qualifications.collectionName,
    );
    const byCategory = getPostsByCategorySorted(
        posts,
        SECTION_CONFIGS.qualifications.sortField,
    );
    return generateCategoryPaths(byCategory);
}

const { category, postsByCategory } = Astro.props;
const categoryPosts = sortPostsByDate(
    postsByCategory[category] || [],
    SECTION_CONFIGS.qualifications.sortField,
);
const others = Object.keys(postsByCategory)
    .filter((c) => c !== category)
    .sort((a, b) => a.localeCompare(b, "ja"));
---

<Layout title={`${category} - 資格`}>
    <SingleGroupView
        client:load
        heading={`カテゴリー：${category}`}
        posts={categoryPosts}
        kind="qualification"
        others={others}
        countMap={postsByCategory}
        sectionSlug="qualifications"
        groupType="categorys"
    />
</Layout>
