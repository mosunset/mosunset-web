---
import Layout from "@/layouts/Layout.astro";
import SwitchBot from "@/components/SwitchBot.astro";
import AutophagyClock from "@/components/AutophagyClock.astro";
import myImage from "@/assets/images/my.webp";
import { Image } from "astro:assets";
---

<Layout>
    <section class="py-16 sm:py-24">
        <div class="mx-auto max-w-5xl">
            <div
                class="grid grid-cols-1 md:grid-cols-2 gap-10 md:gap-12 items-center"
            >
                <div>
                    <h1
                        class="text-3xl sm:text-4xl md:text-5xl font-bold tracking-tight text-gray-900"
                    >
                        たのしく、つくる。
                    </h1>
                    <p class="mt-4 text-gray-600 leading-relaxed">
                        mosunset
                        の個人サイトです。ブログ、楽器、プレイグラウンド、書籍など、
                        日々の試行錯誤とアウトプットをまとめています。
                    </p>
                    <div class="mt-6 flex flex-wrap gap-3">
                        <a
                            href="/blog"
                            title="ブログを見る"
                            class="inline-flex items-center justify-center rounded-md bg-gray-900 px-4 py-2 text-white text-sm font-medium hover:bg-gray-800 focus:outline-hidden focus:ring-2 focus:ring-gray-400"
                        >
                            ブログを見る
                        </a>
                        <a
                            href="/playground"
                            title="Playground で試す"
                            class="inline-flex items-center justify-center rounded-md border border-gray-300 px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50 focus:outline-hidden focus:ring-2 focus:ring-gray-300"
                        >
                            Playground で試す
                        </a>
                    </div>
                </div>
                <div class="order-first md:order-none">
                    <div
                        class="aspect-[4/3] w-full overflow-hidden rounded-xl border border-gray-200 bg-gray-50"
                    >
                        <Image
                            src={myImage}
                            format="webp"
                            alt="mosunset"
                            title="mosunset"
                            class="h-full w-full object-cover"
                            loading="lazy"
                        />
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section id="about" class="py-14 sm:py-20 border-t border-gray-200">
        <div class="mx-auto max-w-4xl">
            <h2 class="text-2xl sm:text-3xl font-semibold text-gray-900">
                <a href="/blog/about">About</a>
            </h2>
            <p class="mt-4 text-gray-700 leading-relaxed">
                mosunset
                は岐阜県出身、現在は高知の大学で情報系を学びながら、日常の「ちょっとした不便」を解決するWebサービスやツールをつくっています。
                中学時代から資格取得に取り組み、高校では商業高校の情報科で学びつつ、Chrome拡張機能やLINE×GASの仕組みなど、実際に使われるプロダクトづくりを続けてきました。
            </p>
        </div>
    </section>

    <SwitchBot />
    <AutophagyClock />
</Layout>
