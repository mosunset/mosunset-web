---
import Layout from "@/layouts/Layout.astro";
import { getCollection } from "astro:content";
const allPosts = await getCollection("playground");
const entry = allPosts.find(
    (post) =>
        post.id === Astro.url.pathname.replace("/playground/", "").slice(0, -1)
);

if (
    !entry ||
    entry.data.draft === true ||
    entry.data.visibility === "private"
) {
    return new Response(null, {
        status: 404,
        statusText: "Not found",
    });
}
---

<Layout title={entry?.data.title}>
    <h1>Masonry - imagesLoaded progress, vanilla JS</h1>

    <div class="grid">
        <div class="grid-sizer"></div>
        <div class="grid-item">
            <img
                src="https://s3-us-west-2.amazonaws.com/s.cdpn.io/82/orange-tree.jpg"
            />
            1
        </div>
        <div class="grid-item">
            <img
                src="https://s3-us-west-2.amazonaws.com/s.cdpn.io/82/submerged.jpg"
            />
            2
        </div>
        <div class="grid-item">
            <img
                src="https://s3-us-west-2.amazonaws.com/s.cdpn.io/82/look-out.jpg"
            />
            3
        </div>
        <div class="grid-item">
            <img
                src="https://s3-us-west-2.amazonaws.com/s.cdpn.io/82/one-world-trade.jpg"
            />
            4
        </div>
        <div class="grid-item">
            <img
                src="https://s3-us-west-2.amazonaws.com/s.cdpn.io/82/drizzle.jpg"
            />
            5
        </div>
        <div class="grid-item">
            <img
                src="https://s3-us-west-2.amazonaws.com/s.cdpn.io/82/cat-nose.jpg"
            />
            6
        </div>
        <div class="grid-item">
            <img
                src="https://s3-us-west-2.amazonaws.com/s.cdpn.io/82/contrail.jpg"
            />
            7
        </div>
        <div class="grid-item">
            <img
                src="https://s3-us-west-2.amazonaws.com/s.cdpn.io/82/golden-hour.jpg"
            />
            8
        </div>
        <div class="grid-item">
            <img
                src="https://s3-us-west-2.amazonaws.com/s.cdpn.io/82/flight-formation.jpg"
            />
            9
        </div>
    </div>
</Layout>
<style>
    * {
        box-sizing: border-box;
    }

    /* force scrollbar */
    html {
        overflow-y: scroll;
    }

    body {
        font-family: sans-serif;
    }

    /* ---- grid ---- */

    .grid {
        background: #ddd;
    }

    /* clear fix */
    .grid:after {
        content: "";
        display: block;
        clear: both;
    }

    /* ---- .grid-item ---- */

    .grid-sizer,
    .grid-item {
        width: 33.333%;
    }

    .grid-item {
        float: left;
    }

    .grid-item img {
        display: block;
        max-width: 100%;
    }
</style>
<script>
    import "/src/components/initMasonry/masonry.pkgd.min.js";
    import "/src/components/initMasonry/imagesloaded.pkgd.min.js";

    var grid = document.querySelector(".grid");

    var msnry = new Masonry(grid, {
        itemSelector: ".grid-item",
        columnWidth: ".grid-sizer",
        percentPosition: true,
    });

    imagesLoaded(grid).on("progress", function () {
        // layout Masonry after each image loads
        msnry.layout();
    });
</script>
