---
import Layout from "@/layouts/Layout.astro";
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import { playgroundContent } from "./_content";

// 'blog' コレクションから全記事を取得
const allPosts = playgroundContent;

// 下書きを除外
const publishedPosts = allPosts.filter((post) => !post.data.draft);

// 公開範囲が公開以外のものを除外
const publicPosts = publishedPosts.filter(
    (post) => post.data.visibility === "public"
);

// 日付の新しい順に並び替え
publicPosts.sort(
    (a, b) =>
        new Date(b.data.publishedDate).getTime() -
        new Date(a.data.publishedDate).getTime()
);

// サムネイル画像を静的解決（astro:assets 用）
const images = import.meta.glob<{ default: ImageMetadata }>(
    "/src/assets/images/playground/**/thumbnail.{jpeg,jpg,JPG,png,gif,webp}"
);

const resolvedImages: Record<string, ImageMetadata> = Object.fromEntries(
    await Promise.all(
        Object.entries(images).map(async ([path, loader]) => {
            const mod = await loader();
            return [path, mod.default as ImageMetadata];
        })
    )
);

function getThumbnailMeta(thumbnailPath: string): ImageMetadata | undefined {
    return resolvedImages[thumbnailPath];
}
---

<Layout title="Playground一覧">
    <style>
        /* Masonryコンテナのスタイル */
        .masonry-container {
            width: 100%;
        }

        /* Masonryアイテムのスタイル */
        .masonry-item {
            width: 100%;
            margin-bottom: 1.5rem;
            opacity: 0;
            transition: opacity 0.3s ease-in-out;
        }

        .masonry-item.loaded {
            opacity: 1;
        }

        /* 画像のアスペクト比を保持 */
        .masonry-item img {
            width: 100%;
            height: auto;
            display: block;
        }

        /* レスポンシブ対応 - Masonry.jsが自動でカラム幅を計算するため、固定幅を設定 */
        @media (min-width: 768px) {
            .masonry-item {
                width: calc(50% - 12px);
            }
        }

        @media (min-width: 1024px) {
            .masonry-item {
                width: calc(33.333% - 16px);
            }
        }

        @media (min-width: 1280px) {
            .masonry-item {
                width: calc(25% - 18px);
            }
        }
    </style>
    <h1 class="text-3xl font-bold text-gray-900 mb-8">
        <span transition:persist-props transition:name="playground-title"
            >Playground</span
        >
    </h1>
    <div id="masonry-container" class="masonry-container">
        {
            publicPosts.length === 0 ? (
                <div class="col-span-full text-center text-gray-500">
                    <p>記事がありません</p>
                </div>
            ) : (
                publicPosts.map((post) => (
                    <article class="masonry-item bg-white border border-gray-200 rounded-lg shadow-sm hover:shadow-md transition-shadow overflow-hidden">
                        <a
                            href={`/playground/${post.slug}/`}
                            class="block"
                            data-astro-reload
                        >
                            {/* 詳細ページへのリンク */}
                            <Image
                                src={getThumbnailMeta(post.data.thumbnail)!}
                                format="webp"
                                alt={post.data.title}
                                class="w-full object-cover"
                                transition:persist-props
                                transition:name={post.slug + "-thumbnail"}
                            />
                            <div class="p-6">
                                <h2
                                    class="text-xl font-semibold text-gray-900 mb-2 line-clamp-2"
                                    transition:persist-props
                                    transition:name={post.slug + "-title"}
                                >
                                    {post.data.title}
                                </h2>
                                {post.data.description && (
                                    <p
                                        class="text-gray-600 mb-3 line-clamp-3"
                                        transition:persist-props
                                        transition:name={
                                            post.slug + "-description"
                                        }
                                    >
                                        {post.data.description}
                                    </p>
                                )}
                                <div class="flex flex-wrap gap-2 mb-3">
                                    <span
                                        class="px-2 py-1 bg-blue-100 text-blue-800 text-xs rounded-full"
                                        transition:persist-props
                                        transition:name={
                                            post.slug + "-category"
                                        }
                                    >
                                        {post.data.category}
                                    </span>
                                    {post.data.tags &&
                                        post.data.tags.length > 0 && (
                                            <div
                                                class="flex gap-2"
                                                transition:persist-props
                                                transition:name={
                                                    post.slug + "-tag"
                                                }
                                            >
                                                {post.data.tags.map((tag) => (
                                                    <span class="px-2 py-1 bg-gray-100 text-gray-700 rounded text-xs">
                                                        #{tag}
                                                    </span>
                                                ))}
                                            </div>
                                        )}
                                </div>
                                <div class="flex flex-col gap-1 mt-auto">
                                    <time
                                        class="text-sm text-gray-500"
                                        transition:persist-props
                                        transition:name={
                                            post.slug + "-publishedDate"
                                        }
                                    >
                                        公開日:{" "}
                                        {new Date(
                                            post.data.publishedDate
                                        ).toLocaleDateString("ja-JP")}
                                    </time>
                                    {post.data.updatedDate && (
                                        <time
                                            class="text-sm text-gray-500"
                                            transition:persist-props
                                            transition:name={
                                                post.slug + "-updatedDate"
                                            }
                                        >
                                            更新日:{" "}
                                            {new Date(
                                                post.data.updatedDate
                                            ).toLocaleDateString("ja-JP")}
                                        </time>
                                    )}
                                </div>
                            </div>
                        </a>
                    </article>
                ))
            )
        }
    </div>
    <script>
        // Masonryライブラリの動的読み込み
        function loadMasonry() {
            return new Promise((resolve, reject) => {
                // @ts-ignore
                if (window.Masonry) {
                    // @ts-ignore
                    resolve(window.Masonry);
                    return;
                }

                const script = document.createElement("script");
                script.src =
                    "https://unpkg.com/masonry-layout@4/dist/masonry.pkgd.min.js";
                script.onload = () => {
                    // @ts-ignore
                    resolve(window.Masonry);
                };
                script.onerror = reject;
                document.head.appendChild(script);
            });
        }

        // Masonry.jsの初期化関数
        async function initMasonry() {
            const container = document.getElementById("masonry-container");
            if (!container) return;

            // Masonryライブラリを読み込み
            try {
                await loadMasonry();
            } catch (error) {
                console.error(
                    "Masonryライブラリの読み込みに失敗しました:",
                    error
                );
                return;
            }

            // 既存のMasonryインスタンスを破棄
            // @ts-ignore
            if (window.masonryInstance) {
                // @ts-ignore
                window.masonryInstance.destroy();
                // @ts-ignore
                window.masonryInstance = null;
            }

            // 画像の読み込み完了を待つ
            const images = container.querySelectorAll("img");
            let loadedImages = 0;

            function checkAllImagesLoaded() {
                loadedImages++;
                if (loadedImages === images.length) {
                    // 全ての画像が読み込まれたらMasonryを初期化
                    createMasonry();
                }
            }

            if (images.length === 0) {
                // 画像がない場合は即座に初期化
                createMasonry();
            } else {
                // 各画像の読み込み完了を監視
                images.forEach((img) => {
                    if (img.complete) {
                        checkAllImagesLoaded();
                    } else {
                        img.addEventListener("load", checkAllImagesLoaded);
                        img.addEventListener("error", checkAllImagesLoaded);
                    }
                });
            }

            function createMasonry() {
                if (!container) return;

                // アイテムを表示
                const items = container.querySelectorAll(".masonry-item");
                items.forEach((item) => {
                    item.classList.add("loaded");
                });

                // Masonry.jsの初期化（左から右、上から下の順序）
                // @ts-ignore
                window.masonryInstance = new window.Masonry(container, {
                    itemSelector: ".masonry-item",
                    columnWidth: ".masonry-item",
                    percentPosition: true,
                    horizontalOrder: true, // 左から右の順序を保つ
                    transitionDuration: "0.3s",
                    gutter: 24, // カラム間の間隔（px）
                });

                // レイアウト完了後に再配置
                // @ts-ignore
                window.masonryInstance.layout();
            }
        }

        // 初回読み込み時の初期化
        document.addEventListener("DOMContentLoaded", initMasonry);

        // View Transitions後の再初期化
        document.addEventListener("astro:after-swap", initMasonry);
    </script>
</Layout>
