---
import Layout from "@/layouts/Layout.astro";
import { getCollection } from "astro:content";
import ItemList from "@/components/ViewToggle/ItemList";
import type { ItemData } from "@/components/ViewToggle/ItemList";

const allPosts = await getCollection("playground");

const posts = allPosts
    .filter((p) => !p.data.draft && p.data.visibility === "public")
    .sort(
        (a, b) =>
            new Date(b.data.publishedDate).getTime() -
            new Date(a.data.publishedDate).getTime(),
    );

const items: ItemData[] = posts.map((p) => ({
    kind: "playground",
    href: `/playground/${p.id}/`,
    title: p.data.title,
    thumbnailSrc: p.data.thumbnail?.src,
    publishedDate: p.data.publishedDate?.toString(),
    updatedDate: p.data.updatedDate?.toString(),
    description: p.data.description,
    category: p.data.category,
    tags: p.data.tags,
}));
---

<Layout title="Playground一覧">
    <h1 class="text-3xl font-bold text-gray-900 mb-6">Playground</h1>
    {
        items.length === 0 ? (
            <p class="text-center text-gray-500">記事がありません</p>
        ) : (
            <ItemList client:load items={items} />
        )
    }
</Layout>
