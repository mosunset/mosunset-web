---
import Layout from "@/layouts/Layout.astro";
import { getCollection } from "astro:content";
const allPosts = await getCollection("playground");
const entry = allPosts.find(
    (post) =>
        post.id === Astro.url.pathname.replace("/playground/", "").slice(0, -1)
);

if (
    !entry ||
    entry.data.draft === true ||
    entry.data.visibility === "private"
) {
    return new Response(null, {
        status: 404,
        statusText: "Not found",
    });
}
---

<Layout title={entry?.data.title}>
    <div class="flex items-center justify-center min-h-screen p-4">
        <div class="w-full max-w-5xl mx-auto p-4 sm:p-6 md:p-8">
