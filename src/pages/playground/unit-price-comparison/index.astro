                    "priceC"
                ) as HTMLInputElement | null,
                unitEl: document.getElementById(
                    "unitC"
                ) as HTMLInputElement | null,
                resultEl: document.getElementById(
                    "resultC"
                ) as HTMLElement | null,
                cardEl: document.getElementById(
                    "itemC-card"
                ) as HTMLElement | null,
            },
        ];

        const resetButton = document.getElementById("resetButton");

        if (
            !resetButton ||
            items.some(
                (item) =>
                    !item.priceEl ||
                    !item.unitEl ||
                    !item.resultEl ||
                    !item.cardEl
            )
        ) {
            console.error("必要な要素が見つかりません");
            return;
        }

        // nullチェック後の型安全な参照
        const safeItems = items.map((item) => ({
            priceEl: item.priceEl!,
            unitEl: item.unitEl!,
            resultEl: item.resultEl!,
            cardEl: item.cardEl!,
        }));

        // --- ハイライト用のクラス ---
        const highlightClass = "border-4 border-green-500 shadow-lg";
        const defaultClass = "border border-gray-200";

        // --- 計算とハイライト処理 ---
        function calculateAndHighlight() {
            let minUnitPrice = Infinity;
            const unitPrices: number[] = [];

            // 1. 全てのハイライトをリセット
            safeItems.forEach((item) => {
                item.cardEl.className = item.cardEl.className.replace(
                    highlightClass,
                    defaultClass
                );
            });

            // 2. 各商品の単価を計算
            safeItems.forEach((item) => {
                const price = parseFloat(item.priceEl.value);
                const unit = parseFloat(item.unitEl.value);
                if (price > 0 && unit > 0) {
                    const unitPrice = price / unit;
                    item.resultEl.textContent = `${parseFloat(unitPrice.toFixed(8)).toString()} 円 / 1単位あたり`;
                    unitPrices.push(unitPrice);

                    // 最小単価を更新
                    if (unitPrice < minUnitPrice) {
                        minUnitPrice = unitPrice;
                    }
                } else {
                    item.resultEl.textContent = "--- 円 / 1単位あたり";
                    unitPrices.push(Infinity); // 計算不能な場合は比較対象外
                }
            });

            // 3. 最小単価のアイテムをハイライト
            if (minUnitPrice !== Infinity) {
                safeItems.forEach((item, index) => {
                    if (unitPrices[index] === minUnitPrice) {
                        item.cardEl.className = item.cardEl.className.replace(
                            defaultClass,
                            highlightClass
                        );
                    }
                });
            }
        }

        // --- リセット処理 ---
        function resetAll() {
            safeItems.forEach((item) => {
                item.priceEl.value = "";
                item.unitEl.value = "";
                item.resultEl.textContent = "--- 円 / 1単位あたり";
                item.cardEl.className = item.cardEl.className.replace(
                    highlightClass,
                    defaultClass
                );
            });
        }

        // --- イベントリスナーの設定 ---
        resetButton.addEventListener("click", resetAll);

        // 入力時に自動計算（Enterキーでも反応するように）
        safeItems.forEach((item) => {
            item.priceEl.addEventListener("input", calculateAndHighlight);
            item.unitEl.addEventListener("input", calculateAndHighlight);
        });

        // --- クイック入力ボタンの処理 ---
        const quickInputButtons = document.querySelectorAll(".quick-input-btn");
        quickInputButtons.forEach((button) => {
            button.addEventListener("click", () => {
                const targetId = button.getAttribute("data-target");
                const valueStr = button.getAttribute("data-value");
                if (!targetId || !valueStr) return;

                const value = parseFloat(valueStr);
                const targetInput = document.getElementById(
                    targetId
                ) as HTMLInputElement | null;

                if (targetInput) {
                    const currentValue = parseFloat(targetInput.value) || 0;
                    targetInput.value = (currentValue + value).toString();
                    // inputイベントを発火して自動計算をトリガー
                    targetInput.dispatchEvent(
                        new Event("input", { bubbles: true })
                    );
                }
            });
        });
    };

    // ページ読み込み時に実行
    if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", main);
    } else {
        main();
    }
</script>
