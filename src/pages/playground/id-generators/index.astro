---
import Layout from "@/layouts/Layout.astro";
import { getCollection } from "astro:content";
const allPosts = await getCollection("playground");
const entry = allPosts.find(
    (post) =>
        post.id === Astro.url.pathname.replace("/playground/", "").slice(0, -1)
);

if (
    !entry ||
    entry.data.draft === true ||
    entry.data.visibility === "private"
) {
    return new Response(null, {
        status: 404,
        statusText: "Not found",
    });
}
---

<Layout title={entry?.data.title}>
    <div class="max-w-[960px] mx-auto p-4">
        <h1 class="text-3xl font-bold text-gray-900 mb-6">ID Generators</h1>
        <div class="mb-4">
            <button
                class="p-2 px-3 border border-gray-300 rounded bg-gray-50 hover:bg-gray-100 cursor-pointer"
                id="regen-all"
            >
                再生成
            </button>
        </div>

        <div class="grid grid-cols-1 gap-3">
            <div
                class="grid grid-cols-[160px_minmax(0,1fr)] sm:grid-cols-1 gap-3 items-center sm:items-start"
            >
                <div class="text-gray-700 font-semibold">UUID v4</div>
                <input
                    id="uuidv4"
                    class="p-2 px-3 border border-gray-300 rounded font-mono whitespace-nowrap overflow-auto"
                    readonly
                />
                <div class="text-gray-500 text-sm col-span-full mt-1">
                    128bit乱数ベース（RFC 4122）。36文字（ハイフン含む）、形式:
                    xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx。順序性なし、Web
                    Crypto由来の強乱数。
                </div>
            </div>
            <div
                class="grid grid-cols-[160px_minmax(0,1fr)] sm:grid-cols-1 gap-3 items-center sm:items-start"
            >
                <div class="text-gray-700 font-semibold">UUID v7</div>
                <input
                    id="uuidv7"
                    class="p-2 px-3 border border-gray-300 rounded font-mono whitespace-nowrap overflow-auto"
                    readonly
                />
                <div class="text-gray-500 text-sm col-span-full mt-1">
                    タイムスタンプ先頭の時系列UUID（RFC
                    9562）。36文字（ハイフン含む）。ミリ秒精度で辞書順ソート可能、分散環境での挿入順最適。
                </div>
            </div>
            <div
                class="grid grid-cols-[160px_minmax(0,1fr)] sm:grid-cols-1 gap-3 items-center sm:items-start"
            >
                <div class="text-gray-700 font-semibold">ULID</div>
                <input
                    id="ulid"
                    class="p-2 px-3 border border-gray-300 rounded font-mono whitespace-nowrap overflow-auto"
                    readonly
                />
                <div class="text-gray-500 text-sm col-span-full mt-1">
                    26文字のCrockford
                    Base32。先頭48bitがミリ秒時刻＋80bit乱数で辞書順ソート可能。URL/ファイル名に安全。
                </div>
            </div>
            <div
                class="grid grid-cols-[160px_minmax(0,1fr)] sm:grid-cols-1 gap-3 items-center sm:items-start"
            >
                <div class="text-gray-700 font-semibold">Cuid2</div>
                <input
                    id="cuid2"
                    class="p-2 px-3 border border-gray-300 rounded font-mono whitespace-nowrap overflow-auto"
                    readonly
                />
                <div class="text-gray-500 text-sm col-span-full mt-1">
                    約24文字の小文字英数字。URLセーフ、偏りの少ない分布で衝突耐性を強化。分散生成・人手扱いに適合。
                </div>
            </div>
            <div
                class="grid grid-cols-[160px_minmax(0,1fr)] sm:grid-cols-1 gap-3 items-center sm:items-start"
            >
                <div class="text-gray-700 font-semibold">NanoID</div>
                <input
                    id="nanoid"
                    class="p-2 px-3 border border-gray-300 rounded font-mono whitespace-nowrap overflow-auto"
                    readonly
                />
                <div class="text-gray-500 text-sm col-span-full mt-1">
                    既定21文字、URLセーフ（A–Z a–z 0–9 _
                    -）。高速度・高エントロピーの短いID。長さは用途に応じ可変。
                </div>
            </div>
        </div>
    </div>

    <script type="module">
        // CDN imports
        import { v7 as uuidv7 } from "https://esm.sh/uuid@10.0.0";
        import { ulid } from "https://esm.sh/ulid@2.3.0";
        import { createId as createCuid2 } from "https://esm.sh/@paralleldrive/cuid2@2.2.2";
        import { nanoid } from "https://esm.sh/nanoid@5.0.7";

        const $ = (id) => document.getElementById(id);

        function setValue(id, value) {
            const el = $(id);
            if (el) {
                el.value = value;
            }
        }

        // Generators
        function genUUIDv4() {
            try {
                const v = crypto.randomUUID();
                setValue("uuidv4", v);
            } catch (e) {
                setValue(
                    "uuidv4",
                    "このブラウザは crypto.randomUUID() に未対応です"
                );
            }
        }

        function genUUIDv7() {
            setValue("uuidv7", uuidv7());
        }

        function genULID() {
            setValue("ulid", ulid());
        }

        function genCuid2() {
            setValue("cuid2", createCuid2());
        }

        function genNanoID() {
            setValue("nanoid", nanoid());
        }

        function regenAll() {
            genUUIDv4();
            genUUIDv7();
            genULID();
            genCuid2();
            genNanoID();
        }

        // Wire button
        document.addEventListener("DOMContentLoaded", () => {
            const btn = document.getElementById("regen-all");
            if (btn) btn.addEventListener("click", regenAll);

            // 初期生成（ページ表示時）
            regenAll();
        });
    </script>
</Layout>
