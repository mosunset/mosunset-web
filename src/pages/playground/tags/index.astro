---
import Layout from "@/layouts/Layout.astro";
import { AllGroupsView } from "@/components/Pages/GroupedItemList";
import {
    getPublicPosts,
    getPostsByTagSorted,
    SECTION_CONFIGS,
} from "@/components/Pages/utils";

const config = SECTION_CONFIGS.playground;
const publicPosts = await getPublicPosts(config.collectionName);
const postsByTag = getPostsByTagSorted(publicPosts, config.sortField);
---

<Layout title="タグ - Playground一覧">
    <AllGroupsView
        client:load
        heading="タグ：Playground"
        groupedPosts={postsByTag}
        kind="playground"
        groupType="tags"
        sectionSlug="playground"
    />
</Layout>
