---
import Layout from "@/layouts/Layout.astro";
import { AllGroupsView } from "@/components/Pages/GroupedItemList";
import {
    getPublicPosts,
    getPostsByTagSorted,
    SECTION_CONFIGS,
} from "@/components/Pages/utils";

const config = SECTION_CONFIGS.instruments;
const publicPosts = await getPublicPosts(config.collectionName);
const postsByTag = getPostsByTagSorted(publicPosts, config.sortField);
---

<Layout title="タグ - 楽器一覧">
    <AllGroupsView
        client:load
        heading="タグ：楽器"
        groupedPosts={postsByTag}
        kind="instrument"
        groupType="tags"
        sectionSlug="instruments"
    />
</Layout>
