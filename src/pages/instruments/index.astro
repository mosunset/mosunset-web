---
import Layout from "@/layouts/Layout.astro";
import { getCollection } from "astro:content";
import ItemList from "@/components/ViewToggle/ItemList";
import type { ItemData } from "@/components/ViewToggle/ItemList";

const allPosts = await getCollection("instruments");

const posts = allPosts
    .filter((p) => !p.data.draft && p.data.visibility === "public")
    .sort((a, b) => (a.data.type ?? "").localeCompare(b.data.type ?? "", "ja"));

const items: ItemData[] = posts.map((p) => ({
    kind: "instrument",
    href: `/instruments/${p.slug}/`,
    title: p.data.name,
    thumbnailSrc: p.data.thumbnail?.src,
    brand: p.data.brand,
    instrumentName: p.data.instrumentName,
    category: p.data.type,
    tags: p.data.tags,
    purchaseDate: p.data.purchaseDate?.toString(),
    status: p.data.status,
}));
---

<Layout title="楽器一覧">
    <h1 class="text-3xl font-bold text-gray-900 mb-6">楽器</h1>
    {
        items.length === 0 ? (
            <p class="text-center text-gray-500">楽器がありません</p>
        ) : (
            <ItemList client:load items={items} />
        )
    }
</Layout>
