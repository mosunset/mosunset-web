---
import Layout from "@/layouts/Layout.astro";
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import InitMasonry from "@/components/initMasonry/index.astro";

// コレクションから全記事を取得
const allPosts = await getCollection("instruments");

// 下書きを除外
const publishedPosts = allPosts.filter((post) => !post.data.draft);

// 公開範囲が公開以外のものを除外
const publicPosts = publishedPosts.filter(
    (post) => post.data.visibility === "public"
);

// 楽器の種類でソート（UTF-8文字コード順）
publicPosts.sort((a, b) => {
    const typeA = a.data.type || "";
    const typeB = b.data.type || "";
    return typeA.localeCompare(typeB, "ja");
});
---

<Layout title="楽器一覧">
    <style>
        /* Masonryコンテナのスタイル */
        .masonry-container {
            width: 100%;
        }

        /* Masonryアイテムのスタイル */
        .masonry-item {
            width: 100%;
            margin-bottom: 1.5rem;
            opacity: 0;
            transition: opacity 0.3s ease-in-out;
        }

        .masonry-item.loaded {
            opacity: 1;
        }

        /* 画像のアスペクト比を保持 */
        .masonry-item img {
            width: 100%;
            height: auto;
            display: block;
        }

        /* レスポンシブ対応 - Masonry.jsが自動でカラム幅を計算するため、固定幅を設定 */
        @media (min-width: 768px) {
            .masonry-item {
                width: calc(50% - 12px);
            }
        }

        @media (min-width: 1024px) {
            .masonry-item {
                width: calc(33.333% - 16px);
            }
        }

        @media (min-width: 1280px) {
            .masonry-item {
                width: calc(25% - 18px);
            }
        }
    </style>
    <h1 class="text-3xl font-bold text-gray-900 mb-8">
        <span transition:persist-props transition:name="instruments-title"
            >楽器</span
        >
    </h1>
    <div id="masonry-container" class="masonry-container">
        {
            publicPosts.length === 0 ? (
                <div class="col-span-full text-center text-gray-500">
                    <p>楽器がありません</p>
                </div>
            ) : (
                publicPosts.map((post) => (
                    <article class="masonry-item bg-white border border-gray-200 rounded-lg shadow-sm hover:shadow-md transition-shadow overflow-hidden">
                        <a
                            href={`/instruments/${post.slug}/`}
                            class="block"
                            title={post.data.name}
                        >
                            {/* 詳細ページへのリンク */}
                            <Image
                                src={post.data.thumbnail}
                                format="webp"
                                alt={post.data.name}
                                title={post.data.name}
                                loading="lazy"
                                class="w-full object-cover"
                                transition:persist-props
                                transition:name={post.slug + "-thumbnail"}
                            />
                            <div class="p-6">
                                <h2
                                    class="text-xl font-semibold text-gray-900 mb-2 line-clamp-2"
                                    transition:persist-props
                                    transition:name={post.slug + "-title"}
                                >
                                    {post.data.name}
                                </h2>
                                <p
                                    class="text-gray-600 mb-2 text-sm"
                                    transition:persist-props
                                    transition:name={post.slug + "-brand"}
                                >
                                    ブランド: {post.data.brand}
                                </p>
                                <p
                                    class="text-gray-600 mb-2 text-sm"
                                    transition:persist-props
                                    transition:name={
                                        post.slug + "-instrumentName"
                                    }
                                >
                                    楽器名: {post.data.instrumentName}
                                </p>
                                <div class="flex flex-wrap gap-2 mb-3">
                                    <span
                                        class="px-2 py-1 bg-blue-100 text-blue-800 text-xs rounded-full"
                                        transition:persist-props
                                        transition:name={post.slug + "-type"}
                                    >
                                        {post.data.type}
                                    </span>
                                </div>
                                {post.data.purchaseDate && (
                                    <div class="flex flex-col gap-1 mt-auto">
                                        <time
                                            class="text-sm text-gray-500"
                                            transition:persist-props
                                            transition:name={
                                                post.slug + "-purchaseDate"
                                            }
                                        >
                                            入手日:{" "}
                                            {new Date(
                                                post.data.purchaseDate
                                            ).toLocaleDateString("ja-JP")}
                                        </time>
                                    </div>
                                )}
                            </div>
                        </a>
                    </article>
                ))
            )
        }
    </div>
    <InitMasonry />
</Layout>
