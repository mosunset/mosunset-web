---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import Layout from "@/layouts/Layout.astro";
import ArticleDetailPage from "@/components/Pages/Article/ArticleDetailPage.astro";
import { SECTION_CONFIGS } from "@/components/Pages/utils";

const config = SECTION_CONFIGS.instruments;

// 1. Astroにどのページを生成すべきか教える
export async function getStaticPaths() {
    const allPosts = await getCollection("instruments");
    const publishedPosts = allPosts.filter((post) => !post.data.draft);
    const publicPosts = publishedPosts.filter(
        (post) => post.data.visibility !== "private"
    );

    return publicPosts.map((post) => ({
        params: { slug: post.slug },
        props: { entry: post },
    }));
}

const { entry } = Astro.props;
---

<Layout title={entry.data.name}>
    <ArticleDetailPage
        entry={entry}
        sectionName={config.sectionName}
        sectionSlug={config.sectionSlug}
        transitionName={config.transitionName}
        titleField="name"
    >
        <Fragment slot="metadata">
            <p
                class="text-gray-600 mb-2 text-sm"
                transition:persist-props
                transition:name={entry.slug + "-brand"}
            >
                ブランド: {entry.data.brand}
            </p>
            <p
                class="text-gray-600 mb-2 text-sm"
                transition:persist-props
                transition:name={entry.slug + "-instrumentName"}
            >
                楽器名: {entry.data.instrumentName}
            </p>
            {
                entry.data.manufactureYear && (
                    <p class="text-gray-600 mb-2 text-sm">
                        製造年: {entry.data.manufactureYear}
                    </p>
                )
            }
            {
                entry.data.serialNumber && (
                    <p class="text-gray-600 mb-2 text-sm">
                        製造番号: {entry.data.serialNumber}
                    </p>
                )
            }
            {
                entry.data.purchaseDate && (
                    <time
                        class="block text-gray-600 mb-2 text-sm"
                        datetime={entry.data.purchaseDate.toISOString()}
                        transition:persist-props
                        transition:name={entry.slug + "-purchaseDate"}
                    >
                        入手日:{" "}
                        {entry.data.purchaseDate.toLocaleDateString("ja-JP", {
                            year: "numeric",
                            month: "long",
                            day: "numeric",
                        })}
                    </time>
                )
            }
            {
                entry.data.purchasePrice
                    ? entry.data.purchasePrice >= 0 && (
                          <p class="text-gray-600 mb-2 text-sm">
                              入手価格: ¥
                              {entry.data.purchasePrice.toLocaleString()}
                          </p>
                      )
                    : null
            }
        </Fragment>

        <Fragment slot="category-tags">
            {
                entry.data.visibility === "unlisted" && (
                    <span class="px-3 py-1 bg-yellow-100 text-yellow-700 rounded-full text-xs font-medium">
                        限定公開
                    </span>
                )
            }
            <a
                href={`/instruments/categorys/${entry.data.type}`}
                title={entry.data.type}
                class="px-3 py-1 bg-blue-100 text-blue-800 rounded-full text-xs font-medium"
                transition:persist-props
                transition:name={entry.slug + "-type"}
            >
                {entry.data.type}
            </a>
            <span
                class="px-2 py-1 bg-green-100 text-green-800 text-xs rounded-full"
            >
                {entry.data.status}
            </span>
        </Fragment>

        <Fragment slot="additional-content">
            {
                entry.data.images && entry.data.images.length > 0 && (
                    <div class="mb-8">
                        <h2 class="text-xl font-bold mb-4 text-gray-900">
                            写真
                        </h2>
                        <div class="grid grid-cols-1 gap-4">
                            {entry.data.images.map((image) => (
                                <Image
                                    src={image}
                                    class="object-cover w-full rounded shadow-lg hover:opacity-90 transition-opacity"
                                    format="webp"
                                    alt={entry.data.name}
                                />
                            ))}
                        </div>
                    </div>
                )
            }
        </Fragment>
    </ArticleDetailPage>
</Layout>
