---
import Layout from "@/layouts/Layout.astro";
import { AllGroupsView } from "@/components/Pages/GroupedItemList";
import {
    getPublicPosts,
    getPostsByCategorySorted,
    SECTION_CONFIGS,
} from "@/components/Pages/utils";

const config = SECTION_CONFIGS.instruments;
const publicPosts = await getPublicPosts(config.collectionName);
const postsByCategory = getPostsByCategorySorted(
    publicPosts,
    config.sortField,
    config.categoryField,
);
---

<Layout title="カテゴリー - 楽器一覧">
    <AllGroupsView
        client:load
        heading="カテゴリー：楽器"
        groupedPosts={postsByCategory}
        kind="instrument"
        groupType="categorys"
        sectionSlug="instruments"
    />
</Layout>
