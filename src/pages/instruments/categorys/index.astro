---
import Layout from "@/layouts/Layout.astro";
import InstrumentCard from "@/components/Card/InstrumentCard.astro";
import CategorysListPage from "@/components/Pages/Categorys/CategorysListPage.astro";
import {
    getPublicPosts,
    getPostsByCategorySorted,
    SECTION_CONFIGS,
} from "@/components/Pages/utils";

const config = SECTION_CONFIGS.instruments;

// コレクションから公開記事を取得
const publicPosts = await getPublicPosts(config.collectionName);

// カテゴリーごとにグループ化してソート（typeフィールドを使用）
const postsByCategory = getPostsByCategorySorted(
    publicPosts,
    config.sortField,
    config.categoryField
);
---

<Layout title="カテゴリー - 楽器一覧">
    <CategorysListPage
        postsByCategory={postsByCategory}
        sectionName={config.sectionName}
        transitionName={config.transitionName}
        borderColor="border-blue-200"
        CardComponent={InstrumentCard}
    />
</Layout>
