---
import Layout from "@/layouts/Layout.astro";
import { SingleGroupView } from "@/components/Pages/GroupedItemList";
import {
    getPublicPosts,
    getPostsByCategorySorted,
    sortPostsByDate,
    SECTION_CONFIGS,
} from "@/components/Pages/utils";

export async function getStaticPaths() {
    const posts = await getPublicPosts(
        SECTION_CONFIGS.instruments.collectionName,
    );
    const byCategory = getPostsByCategorySorted(
        posts,
        SECTION_CONFIGS.instruments.sortField,
        SECTION_CONFIGS.instruments.categoryField,
    );
    return Object.keys(byCategory).map((category) => ({
        params: { slug: category },
        props: { category, postsByCategory: byCategory },
    }));
}

const { category, postsByCategory } = Astro.props;
const categoryPosts = sortPostsByDate(
    postsByCategory[category] || [],
    SECTION_CONFIGS.instruments.sortField,
);
const others = Object.keys(postsByCategory)
    .filter((c) => c !== category)
    .sort((a, b) => a.localeCompare(b, "ja"));
---

<Layout title={`${category} - 楽器`}>
    <SingleGroupView
        client:load
        heading={`カテゴリー：${category}`}
        posts={categoryPosts}
        kind="instrument"
        others={others}
        countMap={postsByCategory}
        sectionSlug="instruments"
        groupType="categorys"
    />
</Layout>
