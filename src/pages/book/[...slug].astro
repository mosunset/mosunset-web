---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import ArticleDetailPage from "@/components/Pages/Article/ArticleDetailPage.astro";
import { SECTION_CONFIGS } from "@/components/Pages/utils";

const config = SECTION_CONFIGS.books;

// 1. Astroにどのページを生成すべきか教える
export async function getStaticPaths() {
    const allPosts = await getCollection("books");
    const publishedPosts = allPosts.filter((post) => !post.data.draft);
    const publicPosts = publishedPosts.filter(
        (post) => post.data.visibility !== "private"
    );

    return publicPosts.map((post) => ({
        params: { slug: post.slug },
        props: { entry: post },
    }));
}

const { entry } = Astro.props;
---

<Layout title={entry.data.title}>
    <ArticleDetailPage
        entry={entry}
        sectionName={config.sectionName}
        sectionSlug={config.sectionSlug}
    >
        <Fragment slot="metadata">
            <p class="text-gray-600 mb-2 text-sm">
                著者: {entry.data.author}
            </p>
            <p class="text-gray-600 mb-2 text-sm">
                出版社: {entry.data.publisher}
            </p>
            <time
                class="block text-gray-600 mb-2 text-sm"
                datetime={entry.data.publishedDate.toISOString()}
            >
                出版日:{" "}
                {
                    entry.data.publishedDate.toLocaleDateString("ja-JP", {
                        year: "numeric",
                        month: "long",
                        day: "numeric",
                    })
                }
            </time>
            {
                entry.data.description && (
                    <p class="text-lg text-gray-600 mb-4">
                        {entry.data.description}
                    </p>
                )
            }

            {
                entry.data.visibility === "unlisted" && (
                    <span class="px-3 py-1 bg-yellow-100 text-yellow-700 rounded-full text-xs font-medium mb-4 inline-block">
                        限定公開
                    </span>
                )
            }
        </Fragment>

        <Fragment slot="category-tags">
            <a
                href={`/book/categorys/${entry.data.category}`}
                title={entry.data.category}
                class="px-3 py-1 bg-blue-100 text-blue-800 rounded-full text-xs font-medium"
            >
                {entry.data.category}
            </a>

            {
                entry.data.tags && entry.data.tags.length > 0 && (
                    <div class="flex gap-2">
                        {entry.data.tags.map((tag) => (
                            <a
                                href={`/book/tags/${tag}`}
                                title={tag}
                                class="px-2 py-1 bg-gray-100 text-gray-700 rounded text-xs"
                            >
                                #{tag}
                            </a>
                        ))}
                    </div>
                )
            }
            <span
                class="px-2 py-1 bg-green-100 text-green-800 text-xs rounded-full"
            >
                {entry.data.status}
            </span>
            <span
                class="px-2 py-1 bg-purple-100 text-purple-800 text-xs rounded-full"
            >
                {entry.data.format}
            </span>
            {
                entry.data.evaluation !== "未評価" && (
                    <span class="px-2 py-1 bg-yellow-100 text-yellow-800 text-xs rounded-full">
                        ★{entry.data.evaluation}
                    </span>
                )
            }
        </Fragment>
    </ArticleDetailPage>
</Layout>
