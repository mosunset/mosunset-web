---
import Layout from "@/layouts/Layout.astro";
import { SingleGroupView } from "@/components/Pages/GroupedItemList";
import {
    getPublicPosts,
    getPostsByTagSorted,
    generateTagPaths,
    sortPostsByDate,
    SECTION_CONFIGS,
} from "@/components/Pages/utils";

export async function getStaticPaths() {
    const posts = await getPublicPosts(SECTION_CONFIGS.books.collectionName);
    const byTag = getPostsByTagSorted(posts, SECTION_CONFIGS.books.sortField);
    return generateTagPaths(byTag);
}

const { tag, postsByTag } = Astro.props;
const tagPosts = sortPostsByDate(
    postsByTag[tag] || [],
    SECTION_CONFIGS.books.sortField,
);
const others = Object.keys(postsByTag)
    .filter((t) => t !== tag)
    .sort((a, b) => a.localeCompare(b, "ja"));
---

<Layout title={`#${tag} - 蔵書`}>
    <SingleGroupView
        client:load
        heading={`タグ：#${tag}`}
        posts={tagPosts}
        kind="book"
        others={others}
        countMap={postsByTag}
        sectionSlug="book"
        groupType="tags"
    />
</Layout>
