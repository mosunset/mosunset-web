---
import Layout from "@/layouts/Layout.astro";
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import InitMasonry from "@/components/initMasonry/index.astro";

// コレクションから全記事を取得
const allPosts = await getCollection("books");

// 下書きを除外
const publishedPosts = allPosts.filter((post) => !post.data.draft);

// 公開範囲が公開以外のものを除外
const publicPosts = publishedPosts.filter(
    (post) => post.data.visibility === "public"
);

// 日付の新しい順に並び替え
// 更新日が存在する場合は更新日を優先
// 更新日が存在しない場合は公開日を優先
publicPosts.sort(
    (a, b) =>
        new Date(b.data.publishedDate).getTime() -
        new Date(a.data.publishedDate).getTime()
);
---

<Layout title="蔵書一覧">
    <style>
        /* Masonryコンテナのスタイル */
        .masonry-container {
            width: 100%;
        }

        /* Masonryアイテムのスタイル */
        .masonry-item {
            width: 100%;
            margin-bottom: 1.5rem;
            opacity: 0;
            transition: opacity 0.3s ease-in-out;
        }

        .masonry-item.loaded {
            opacity: 1;
        }

        /* 画像のアスペクト比を保持 */
        .masonry-item img {
            width: 100%;
            height: auto;
            display: block;
        }

        /* レスポンシブ対応 - Masonry.jsが自動でカラム幅を計算するため、固定幅を設定 */
        @media (min-width: 768px) {
            .masonry-item {
                width: calc(50% - 12px);
            }
        }

        @media (min-width: 1024px) {
            .masonry-item {
                width: calc(33.333% - 16px);
            }
        }

        @media (min-width: 1280px) {
            .masonry-item {
                width: calc(25% - 18px);
            }
        }
    </style>
    <h1 class="text-3xl font-bold text-gray-900 mb-8">
        <span transition:persist-props transition:name="book-title">蔵書</span>
    </h1>
    <div id="masonry-container" class="masonry-container">
        {
            publicPosts.length === 0 ? (
                <div class="col-span-full text-center text-gray-500">
                    <p>蔵書がありません</p>
                </div>
            ) : (
                publicPosts.map((post) => (
                    <article class="masonry-item bg-white border border-gray-200 rounded-lg shadow-sm hover:shadow-md transition-shadow overflow-hidden">
                        <a
                            href={`/book/${post.slug}/`}
                            class="block"
                            title={post.data.title}
                        >
                            {/* 詳細ページへのリンク */}
                            <Image
                                src={post.data.thumbnail}
                                format="webp"
                                alt={post.data.title}
                                title={post.data.title}
                                loading="lazy"
                                class="w-full object-cover"
                                transition:persist-props
                                transition:name={post.slug + "-thumbnail"}
                            />
                            <div class="p-6">
                                <h2
                                    class="text-xl font-semibold text-gray-900 mb-2 line-clamp-2"
                                    transition:persist-props
                                    transition:name={post.slug + "-title"}
                                >
                                    {post.data.title}
                                </h2>
                                <p
                                    class="text-gray-600 mb-2 text-sm"
                                    transition:persist-props
                                    transition:name={post.slug + "-author"}
                                >
                                    著者: {post.data.author}
                                </p>
                                <p
                                    class="text-gray-600 mb-2 text-sm"
                                    transition:persist-props
                                    transition:name={post.slug + "-publisher"}
                                >
                                    出版社: {post.data.publisher}
                                </p>
                                <time
                                    class="block text-gray-600 mb-2 text-sm"
                                    transition:persist-props
                                    transition:name={
                                        post.slug + "-publishedDate"
                                    }
                                >
                                    出版日:{" "}
                                    {new Date(
                                        post.data.publishedDate
                                    ).toLocaleDateString("ja-JP")}
                                </time>
                                {post.data.description && (
                                    <p
                                        class="text-gray-600 mb-3 line-clamp-3"
                                        transition:persist-props
                                        transition:name={
                                            post.slug + "-description"
                                        }
                                    >
                                        {post.data.description}
                                    </p>
                                )}
                                <div class="flex flex-wrap gap-2 mb-3">
                                    <span
                                        class="px-2 py-1 bg-blue-100 text-blue-800 text-xs rounded-full"
                                        transition:persist-props
                                        transition:name={
                                            post.slug + "-category"
                                        }
                                    >
                                        {post.data.category}
                                    </span>
                                    {post.data.tags &&
                                        post.data.tags.length > 0 && (
                                            <div
                                                class="flex gap-2"
                                                transition:persist-props
                                                transition:name={
                                                    post.slug + "-tag"
                                                }
                                            >
                                                {post.data.tags.map((tag) => (
                                                    <span class="px-2 py-1 bg-gray-100 text-gray-700 rounded text-xs">
                                                        #{tag}
                                                    </span>
                                                ))}
                                            </div>
                                        )}
                                </div>
                                <div class="flex flex-wrap gap-2 mb-3">
                                    <span
                                        class="px-2 py-1 bg-green-100 text-green-800 text-xs rounded-full"
                                        transition:persist-props
                                        transition:name={post.slug + "-status"}
                                    >
                                        {post.data.status}
                                    </span>
                                    <span
                                        class="px-2 py-1 bg-purple-100 text-purple-800 text-xs rounded-full"
                                        transition:persist-props
                                        transition:name={post.slug + "-format"}
                                    >
                                        {post.data.format}
                                    </span>
                                    {post.data.evaluation !== "未評価" && (
                                        <span
                                            class="px-2 py-1 bg-yellow-100 text-yellow-800 text-xs rounded-full"
                                            transition:persist-props
                                            transition:name={
                                                post.slug + "-evaluation"
                                            }
                                        >
                                            ★{post.data.evaluation}
                                        </span>
                                    )}
                                </div>
                            </div>
                        </a>
                    </article>
                ))
            )
        }
    </div>
    <InitMasonry />
</Layout>
