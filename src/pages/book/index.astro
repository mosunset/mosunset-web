---
import Layout from "@/layouts/Layout.astro";
import { getCollection } from "astro:content";
import ItemList from "@/components/ViewToggle/ItemList";
import type { ItemData } from "@/components/ViewToggle/ItemList";

const allPosts = await getCollection("books");

const posts = allPosts
    .filter((p) => !p.data.draft && p.data.visibility === "public")
    .sort(
        (a, b) =>
            new Date(b.data.publishedDate).getTime() -
            new Date(a.data.publishedDate).getTime(),
    );

const items: ItemData[] = posts.map((p) => ({
    kind: "book",
    href: `/book/${p.slug}/`,
    title: p.data.title,
    thumbnailSrc: p.data.thumbnail?.src,
    author: p.data.author,
    publisher: p.data.publisher,
    publishedDate: p.data.publishedDate?.toString(),
    description: p.data.description,
    category: p.data.category,
    tags: p.data.tags,
    status: p.data.status,
    format: p.data.format,
    evaluation: p.data.evaluation,
}));
---

<Layout title="蔵書一覧">
    <h1 class="text-3xl font-bold text-gray-900 mb-6">蔵書</h1>
    {
        items.length === 0 ? (
            <p class="text-center text-gray-500">蔵書がありません</p>
        ) : (
            <ItemList client:load items={items} />
        )
    }
    <p class="text-gray-400 text-xs mt-6">
        本の情報は楽天Books API・Google Books API から取得し、AI
        によって自動整形・補完されています。正式な情報はご自身でご確認ください。
    </p>
</Layout>
