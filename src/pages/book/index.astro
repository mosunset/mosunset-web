---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import Layout from "@/layouts/Layout.astro";

// 'books' コレクションを取得
const allBooks = await getCollection("books");

// カテゴリ別や著者別でソートやグループ化も可能
allBooks.sort((a, b) => a.data.title.localeCompare(b.data.title)); // タイトル順
---

<Layout title="蔵書リスト">
    <h1 class="text-3xl font-bold text-gray-900 mb-8">蔵書リスト</h1>
    <div
        class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6"
    >
        {
            allBooks.map((book) => (
                <div class="bg-white border border-gray-200 rounded-lg shadow-sm hover:shadow-md transition-shadow overflow-hidden">
                    {book.data.coverImage && (
                        <Image
                            src={book.data.coverImage}
                            format="webp"
                            alt={`${book.data.title}の表紙`}
                            class="w-full aspect-[4/3] object-cover"
                        />
                    )}
                    <div class="p-6">
                        <h3 class="text-xl font-semibold text-gray-900 mb-2">
                            {book.data.title}
                        </h3>
                        <p class="text-gray-600 mb-3">
                            著者: {book.data.author}
                        </p>
                        <div class="space-y-1">
                            <p class="text-sm text-gray-500">
                                カテゴリ: {book.data.category}
                            </p>
                            <p class="text-sm text-gray-500">
                                状態: {book.data.status}
                            </p>
                            <p class="text-sm text-gray-500">
                                形式: {book.data.format}
                            </p>
                        </div>
                    </div>
                </div>
            ))
        }
    </div>
</Layout>
